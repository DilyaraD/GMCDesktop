<Page x:Class="GeotekMetallCompleteDesktop.ProjectsManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700"
      Title="Управление проектами">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="FilterStackPanel" 
                    Orientation="Horizontal" 
                    Grid.Row="0" Height="60"
                    Style="{StaticResource FilterPanelStyle}">
            <ComboBox x:Name="SortByDeadlineComboBox" SelectionChanged="SortByDeadlineComboBox_SelectionChanged" Margin="0,15,0,15" >
                <ComboBoxItem Content="Сортировка по дате" IsSelected="True"/>
                <ComboBoxItem Content="Ближайшие"/>
                <ComboBoxItem Content="Убывание"/>
            </ComboBox>
            <TextBox x:Name="SearchTextBox" 
                     Style="{StaticResource TextBoxStyle}" Width="300" 
                     Visibility="Collapsed" Tag="Поиск по названию работы" 
                     Text="Поиск по названию работы" Margin="10, 10, 0, 10"
                     TextChanged="SearchTextBox_TextChanged"/>
            <ToggleButton x:Name="SearchToggleButton" 
                          Content="Поиск" Height="auto" Margin=" 10, 10, 0, 10"
                          Style="{StaticResource ToggleButtonStyle}" 
                          Checked="SearchToggleButton_Checked" 
                          Unchecked="SearchToggleButton_Unchecked"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ProjectsDataGrid2"  VerticalScrollBarVisibility="Auto" >
                <ListView x:Name="ProjectsDataGrid"  MouseDoubleClick="ProjectsDataGrid_SelectionChanged" Height="600">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Номер проекта" 
                                            DisplayMemberBinding="{Binding ProjectID}" 
                                            Width="auto"/>
                            <GridViewColumn Header="Название работы" 
                                            DisplayMemberBinding="{Binding WorkName}" 
                                            Width="auto"/>
                            <GridViewColumn Header="Дата начала" 
                                            DisplayMemberBinding="{Binding ProjectStartDate, StringFormat=dd.MM.yyyy}" 
                                            Width="auto"/>
                            <GridViewColumn Header="Количество этапов" 
                                            DisplayMemberBinding="{Binding StageCount}" 
                                            Width="auto"/>
                            <GridViewColumn Header="Статус" 
                                            DisplayMemberBinding="{Binding Status}" 
                                            Width="auto"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>

            <ScrollViewer x:Name="ProjectDetailsStackPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Height="650">
                <StackPanel>
                    <Button x:Name="BackToUserButton" 
                            Content="Назад к пользователю" 
                            Click="BackToUserButton_Click" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,0,10" 
                            HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ProjectDetailsTitle" 
                               Text="Детали проекта" 
                               Style="{StaticResource SectionHeaderStyle}" 
                               Margin="0,0,0,10"/>
                    <ItemsControl x:Name="RequestDetailsItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" 
                                               Style="{StaticResource InputLabelStyle}" 
                                               Grid.Column="0"/>
                                    <TextBlock Text="{Binding Value}" 
                                               Style="{StaticResource ValueStyle}" 
                                               Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ActsOfWorkTitle" 
                               Text="Акты выполненных работ" Margin="0,5"
                               Style="{StaticResource SubSectionHeaderStyle}"  />
                    <ItemsControl x:Name="ActsOfWorkItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding ActDate, StringFormat='Акт от {0:dd.MM.yyyy}'}" 
                                               Style="{StaticResource ValueStyle}" 
                                               VerticalAlignment="Center"/>
                                    <Button Content="Скачать" 
                                            Tag="{Binding}" 
                                            Click="DownloadFileButton_Click" 
                                            Style="{StaticResource DownloadButtonStyle}" 
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ContractsTitle" 
                               Text="Договоры" Margin="0,5"
                               Style="{StaticResource SubSectionHeaderStyle}" />
                    <ItemsControl x:Name="ContractsItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding ContractDate, StringFormat='Договор от {0:dd.MM.yyyy}'}" 
                                               Style="{StaticResource ValueStyle}" 
                                               VerticalAlignment="Center"/>
                                    <Button Content="Скачать" 
                                            Tag="{Binding}" 
                                            Click="DownloadFileButton_Click" 
                                            Style="{StaticResource DownloadButtonStyle}" 
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="StageButtonsStackPanel"  Orientation="Vertical"
                                Margin="0,10,0,0"/>
                    <StackPanel Style="{StaticResource ActionsStackPanelStyle}">
                        <Button x:Name="BackButton" 
                                Content="Назад" 
                                Click="BackButton_Click" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="AddStageButton" 
                                Content="Добавить этап" 
                                Click="AddStageButton_Click" 
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="CancelProjectButton" 
                                Content="Отменить проект" Width="auto"
                                Click="CancelProjectButton_Click" 
                                Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="AddStagePanel" 
                    Visibility="Collapsed" 
                    Style="{StaticResource BorderStyle}">
                <StackPanel>
                    <TextBlock Text="Добавить новый этап" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="ProjectDATETextBlock" 
                               Style="{StaticResource ValueStyle}" 
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="StagesInfoTextBlock" 
                               Style="{StaticResource ValueStyle}" 
                               Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Описание этапа:" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   Grid.Row="0" Grid.Column="0" 
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="StageDescriptionTextBox" 
                                 Style="{StaticResource TextBoxStyle}"  MaxLength="150"
                                 Grid.Row="0" Grid.Column="1" 
                                 Margin="10,0,0,10"/>
                        <TextBlock Text="Дата начала этапа:" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   Grid.Row="1" Grid.Column="0" 
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="StageStartDatePicker" 
                                    Style="{StaticResource DatePickerStyle}" 
                                    Grid.Row="1" Grid.Column="1" 
                                    Margin="10,0,0,10"/>
                        <TextBlock Text="Дата окончания этапа:" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   Grid.Row="2" Grid.Column="0" 
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="StageEndDatePicker" 
                                    Style="{StaticResource DatePickerStyle}" 
                                    Grid.Row="2" Grid.Column="1" 
                                    Margin="10,0,0,15"/>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    Grid.Row="3" Grid.Column="1">
                            <Button x:Name="CancelAddStageButton" 
                                    Content="Отмена" 
                                    Click="CancelAddStageButton_Click" 
                                    Style="{StaticResource CancelButtonStyle}"/>
                            <Button x:Name="SaveStageButton" 
                                    Content="Добавить" 
                                    Click="SaveStageButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="AddTaskPanel" 
                    Visibility="Collapsed" 
                    Style="{StaticResource BorderStyle}">
                <StackPanel>
                    <TextBlock Text="Добавить задачу" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="StageDATETextBlock" Style="{StaticResource ValueStyle}"  Margin="0,0,0,10"/>
                    <TextBlock x:Name="StagesInfoTextBlock2" Style="{StaticResource ValueStyle}"  Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Описание задачи:" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   Grid.Row="0" Grid.Column="0" 
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TaskDescriptionTextBox" 
                                 Style="{StaticResource TextBoxStyle}" 
                                 Grid.Row="0" Grid.Column="1" MaxLength="150"
                                 Margin="10,0,0,10"/>
                        <TextBlock Text="Дата готовности:" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   Grid.Row="1" Grid.Column="0" 
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="TaskDueDatePicker" 
                                    Style="{StaticResource DatePickerStyle}" 
                                    Grid.Row="1" Grid.Column="1" 
                                    Margin="10,0,0,15"/>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    Grid.Row="2" Grid.Column="1">
                            <Button x:Name="CancelAddTaskButton" 
                                    Content="Отмена" 
                                    Click="CancelAddTaskButton_Click" 
                                    Style="{StaticResource CancelButtonStyle}"/>
                            <Button x:Name="SaveTaskButton" 
                                    Content="Добавить" 
                                    Click="SaveTaskButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="StageDetailsStackPanel" 
                          Visibility="Collapsed"  Height="620"
                          VerticalScrollBarVisibility="Hidden" Margin="10">
                <StackPanel>
                    <TextBlock x:Name="StageDetailsTitle" 
                               Text="Информация об этапе" 
                               Style="{StaticResource SectionHeaderStyle}" 
                               Margin="0,0,0,10"/>
                    <ItemsControl x:Name="StageDetailsItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" 
                                               Style="{StaticResource InputLabelStyle}" 
                                               Grid.Column="0"/>
                                    <TextBlock Text="{Binding Value}" 
                                               Style="{StaticResource ValueStyle}" 
                                               Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TasksTitle" 
                               Text="Задачи" 
                               Style="{StaticResource SubSectionHeaderStyle}" 
                               Margin="0,10,0,5"/>
                    <ItemsControl x:Name="TasksItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TaskDescription}" 
                                        Click="TaskButton_Click" 
                                        Tag="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoTasksText" 
                               Text="Нет задач в этом этапе" 
                               Style="{StaticResource ValueStyle}" 
                               Visibility="Collapsed" 
                               Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" 
                                Style="{StaticResource ActionsStackPanelStyle}">
                        <Button x:Name="BackFromStageButton" 
                                Content="Назад" 
                                Click="BackFromStageButton_Click" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="AddTaskButton" 
                                Content="Добавить задачу" 
                                Click="AddTaskButton_Click" 
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="TaskDetailsPanel" 
                          Visibility="Collapsed" Height="620"
                          VerticalScrollBarVisibility="Hidden" Margin="10">
                <StackPanel>
                    <TextBlock Text="Детали задачи" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <ItemsControl x:Name="TaskDetailsItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" 
                                               Style="{StaticResource InputLabelStyle}" 
                                               Grid.Column="0"/>
                                    <TextBlock Text="{Binding Value}" 
                                               Style="{StaticResource ValueStyle}" 
                                               Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TaskWorkersTitle" 
                               Text="Работники:" 
                               Style="{StaticResource SubSectionHeaderStyle}" 
                               Margin="0,10,0,5"/>
                    <ItemsControl x:Name="TaskWorkersItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ValueStyle}" 
                                           Margin="0,2" FontSize="14">
                                    <Run Text="{Binding Users.FirstName}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Users.LastName}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TaskReportsTitle" 
                               Text="Отчеты:" 
                               Style="{StaticResource SubSectionHeaderStyle}" 
                               Margin="0,10,0,5"/>
                    <ItemsControl x:Name="TaskReportsItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource ActsOfWorkPage_BorderBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="0,0,0,5" 
                                        Margin="0,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" 
                                                   Style="{StaticResource ValueStyle}" 
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding UploadDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                                   Style="{StaticResource ValueStyle}" 
                                                   FontSize="12"/>
                                        <ItemsControl ItemsSource="{Binding TaskReportFiles}" 
                                                      Margin="10,5,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image x:Name="TaskReportImage" Width="50" Height="50" Margin="0,0,5,5" Cursor="Hand" Loaded="TaskReportImage_Loaded"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoReportsText" 
                               Text="Еще отчет не прикреплен" 
                               Style="{StaticResource SubSectionHeaderStyle}" 
                               Visibility="Collapsed" 
                               Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" 
                                Style="{StaticResource ActionsStackPanelStyle}">
                        <Button x:Name="BackFromTaskButton" 
                                Content="Назад" 
                                Click="BackFromTaskButton_Click" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="CompleteTaskButton" 
                                Content="Завершить" 
                                Click="CompleteTaskButton_Click" 
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="CancelTaskButton" 
                                Content="Отменить" 
                                Click="CancelTaskButton_Click" 
                                Style="{StaticResource DangerButtonStyle}"/>
                        <Button x:Name="ResetReportButton" 
                                Content="Сбросить отчет" 
                                Click="ResetReportButton_Click" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Tag="{Binding}" 
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="ImagePreviewOverlay" 
                    Visibility="Collapsed" 
                    Background="#80000000" 
                    Panel.ZIndex="1000">
                <Grid>
                    <Image x:Name="PreviewImage" 
                           Stretch="Uniform" 
                           MaxWidth="600" 
                           MaxHeight="600" 
                           Margin="20" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Effect="{StaticResource ShadowEffect}"/>
                    <Button x:Name="ClosePreviewButton" 
                            Content="✕" 
                            FontSize="20" 
                            Foreground="White" 
                            Background="{StaticResource ActsOfWorkPage_AccentBrush}" 
                            BorderThickness="0" 
                            Width="40" 
                            Height="40" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            Margin="0,10,10,0" 
                            Click="ClosePreviewButton_Click"
                            Style="{StaticResource DangerButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
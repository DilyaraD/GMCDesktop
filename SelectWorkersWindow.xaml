<Window x:Class="GeotekMetallCompleteDesktop.SelectWorkersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор исполнителей" 
         WindowStartupLocation="CenterScreen" Height="470" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Выберите рабочих:" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="WorkersListBox" Height="350">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding FullName}" 
                                  IsChecked="{Binding IsSelected}" 
                                  Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Сохранить" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
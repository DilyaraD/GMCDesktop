<Page x:Class="GeotekMetallCompleteDesktop.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700"
      Title="Проекты в работе">
    <Grid>
        <Grid>
            <StackPanel x:Name="ProjectsListPanel">
                <StackPanel x:Name="FiltersPanel" 
                            Orientation="Horizontal" 
                            Style="{StaticResource FilterPanelStyle}" Margin="10,0,10,10" Height="auto">
                    <ComboBox x:Name="StatusFilterComboBox" SelectionChanged="FilterChanged"  Margin="0,3,10,0" Height="30">
                        <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                        <ComboBoxItem Content="Новый"/>
                        <ComboBoxItem Content="В работе"/>
                        <ComboBoxItem Content="Завершен"/>
                        <ComboBoxItem Content="Отменен"/>
                        <ComboBoxItem Content="Задерживается"/>
                    </ComboBox>
                    <ComboBox x:Name="SortComboBox" SelectionChanged="FilterChanged"  Margin="0,3,10,0" Height="30">
                        <ComboBoxItem Content="Сортировка по дате" IsSelected="True"/>
                        <ComboBoxItem Content="По возрастанию срока"/>
                        <ComboBoxItem Content="По убыванию срока"/>
                    </ComboBox>
                    <Button x:Name="ResetFiltersButton" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Click="ResetFilters_Click" 
                            Visibility="Collapsed" Content="Сбросить фильтры"/>
                </StackPanel>
                <ListView x:Name="ProjectsListView" SelectionChanged="ProjectsListView_SelectionChanged" Height="600">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Название проекта" 
                                            DisplayMemberBinding="{Binding Requests.ObjectName}" 
                                            Width="200"/>
                            <GridViewColumn Header="Адрес" 
                                            DisplayMemberBinding="{Binding Requests.Address}" 
                                            Width="200"/>
                            <GridViewColumn Header="Дата начала" 
                                            DisplayMemberBinding="{Binding ProjectStartDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                            Width="auto"/>
                            <GridViewColumn Header="Дата окончания" 
                                            DisplayMemberBinding="{Binding ProjectEndDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                            Width="auto"/>
                            <GridViewColumn Header="Статус" 
                                            Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Loaded="ProjectStatusTextBlock_Loaded"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

            <ScrollViewer x:Name="ProjectDetailsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="auto" Height="660">
                <StackPanel x:Name="ProjectDetailsStackPanel">
                    <Button x:Name="BackToUserButton" 
                            Content="Назад к списку" 
                            Click="BackButton_Click" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ProjectDetailsTitle" 
                               Text="Детали проекта" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <ItemsControl x:Name="RequestDetailsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" 
                                               Style="{StaticResource InputLabelStyle}" 
                                               Grid.Column="0"/>
                                    <TextBlock Text="{Binding Value}" 
                                               Style="{StaticResource ValueStyle}" 
                                               Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ActsOfWorkTitle" 
                               Text="Акты выполненных работ" 
                               Style="{StaticResource SubSectionHeaderStyle}"/>
                    <ItemsControl x:Name="ActsOfWorkItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding ActDate, StringFormat='Акт от {0:dd.MM.yyyy}'}" 
                                               Style="{StaticResource ValueStyle}" 
                                               VerticalAlignment="Center"/>
                                    <Button Content="Скачать" 
                                            Tag="{Binding}" 
                                            Click="DownloadFileButton_Click" 
                                            Style="{StaticResource DownloadButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoActsText" 
                               Text="Нет прикрепленных актов" 
                               Style="{StaticResource SubSectionHeaderStyle}" 
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="ContractsTitle" 
                               Text="Договоры" 
                               Style="{StaticResource SubSectionHeaderStyle}"/>
                    <ItemsControl x:Name="ContractsItemsControl" 
                                  Style="{StaticResource ItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding ContractDate, StringFormat='Договор от {0:dd.MM.yyyy}'}" 
                                               Style="{StaticResource ValueStyle}" 
                                               VerticalAlignment="Center"/>
                                    <Button Content="Скачать" 
                                            Tag="{Binding}" 
                                            Click="DownloadFileButton_Click" 
                                            Style="{StaticResource DownloadButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoContractsText" 
                               Text="Нет прикрепленных договоров" 
                               Style="{StaticResource SubSectionHeaderStyle}" 
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="TasksTitle" 
                               Text="Все задачи проекта" 
                               Style="{StaticResource SubSectionHeaderStyle}"/>
                    <ListBox x:Name="AllTasksListBox" 
         SelectionChanged="TasksListBox_SelectionChanged"
         Style="{StaticResource TaskListBoxStyle}"
         ItemContainerStyle="{StaticResource TaskListItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding TaskDescription}" 
                           Style="{StaticResource TaskDescriptionTextStyle}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Срок: " 
                               Style="{StaticResource DueDateTextStyle}"/>
                                        <TextBlock Text="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}" 
                               Style="{StaticResource DueDateTextStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Statuses.StatusName}" 
                           Style="{StaticResource StatusTextStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoTasksText" 
                               Text="Выделенных задач нет" 
                               Style="{StaticResource ValueStyle}" 
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="TaskDetailsPanel" 
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="TaskBackButton" 
                        Content="Назад к проекту" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Click="TaskBackButton_Click" 
                        HorizontalAlignment="Left"/>
                <ScrollViewer Grid.Row="1"  Margin="10" VerticalScrollBarVisibility="Hidden" Height="600">                   
                    <StackPanel>
                        <TextBlock Text="Детали задачи" 
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock x:Name="TaskDescriptionText" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Срок выполнения:" 
                                   FontSize="14" 
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TaskDueDateText" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Статус:" 
                                   FontSize="14" 
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TaskStatusText" 
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock x:Name="ResponsibleTitle" 
                                   Text="Ответственные:" 
                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                        <ItemsControl x:Name="TaskUsersItemsControl" 
                                      Style="{StaticResource ItemsControlStyle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ValueStyle}" FontSize="16" Foreground="Black">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Users.LastName" TargetNullValue="[Не указано]"/>
                                                <Binding Path="Users.FirstName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ReportsTitle" 
                                   Text="Отчеты:" 
                                   Style="{StaticResource SubSectionHeaderStyle}"/>
                        <ItemsControl x:Name="TaskReportsItemsControl" 
                                      Style="{StaticResource ItemsControlStyle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource ActsOfWorkPage_BorderBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,0,0,5" 
                                            Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" 
                                                       Style="{StaticResource ValueStyle}" 
                                                       TextWrapping="Wrap" FontSize="14"/>
                                            <TextBlock Text="{Binding UploadDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                                       Style="{StaticResource ValueStyle}" 
                                                       FontSize="12"/>
                                            <ItemsControl ItemsSource="{Binding TaskReportFiles}" 
                                                          Margin="10,5,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image x:Name="TaskReportImage" Loaded="TaskReportImage_Loaded" Margin="5"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoReportsText" 
                                   Text="Еще отчет не прикреплен" 
                                   Style="{StaticResource SubSectionHeaderStyle}" 
                                   Visibility="Collapsed"/>
                        <Button x:Name="SendReportButton" 
                                Content="Отправить отчет" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Click="SendReportButton_Click" 
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border x:Name="ImagePreviewOverlay" 
                Visibility="Collapsed" 
                Background="#80000000" 
                Panel.ZIndex="1000">
            <Grid>
                <Image x:Name="PreviewImage" 
                       Stretch="Uniform" 
                       MaxWidth="600" 
                       MaxHeight="600" 
                       Margin="20" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Effect="{StaticResource ShadowEffect}"/>
                <Button x:Name="ClosePreviewButton" 
                        Content="✕" 
                        Style="{StaticResource DangerButtonStyle}" 
                        Width="40" 
                        Height="40" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,10,10,0" 
                        Click="ClosePreviewButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="ReportFormOverlay" 
                Visibility="Collapsed" 
                Background="#80000000" 
                Panel.ZIndex="1001" Height="auto" MaxHeight="700">
            <Border Style="{StaticResource BorderStyle}" 
                    Width="650" Height="auto"
                    MaxHeight="700">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Отправка отчета" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Описание отчета:" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <TextBox x:Name="ReportDescriptionTextBox" 
                                 Style="{StaticResource TextBoxStyle}" 
                                 AcceptsReturn="True"  VerticalContentAlignment="Top" MaxLength="1500"
                                 TextWrapping="Wrap" 
                                 Height="150"/>
                        <TextBlock Text="Фотографии (максимум 10):" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <Button Content="Добавить фото" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Click="AddPhotosButton_Click" 
                                HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="SelectedFilesItemsControl" 
                                      Style="{StaticResource ItemsControlStyle}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <Image Source="{Binding}" />
                                        <Button Content="✕" 
                                                Style="{StaticResource DangerButtonStyle}" 
                                                Width="20" 
                                                Height="20" 
                                                Margin="0,-25,0,0" 
                                                HorizontalAlignment="Right" 
                                                Click="RemovePhotoButton_Click" 
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Style="{StaticResource ActionsStackPanelStyle}">
                        <Button Content="Отмена" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Click="CancelReportButton_Click"/>
                        <Button Content="Отправить" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Click="SubmitReportButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Page>
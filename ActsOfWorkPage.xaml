<Page x:Class="GeotekMetallCompleteDesktop.ActsOfWorkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700" 
      Title="Управление актами">
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
                <Button Content="Добавить акт" Click="AddActButton_Click" Margin="0,0,10,0" />
                <Button Content="Выбрать проект" Click="SelectProjectButton_Click" Margin="0,0,10,0" />
                <Button Content="Сбросить проект" Click="ResetProjectButton_Click" Margin="0,0,10,0"  />
            </StackPanel>
        <StackPanel Grid.Row="1" >

            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListView x:Name="ActsListView"  
                      Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource SizeConverter}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ActID}" Width="50" />
                        <GridViewColumn Header="Дата акта" DisplayMemberBinding="{Binding ActDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100" />
                        <GridViewColumn Header="Тип файла" DisplayMemberBinding="{Binding FileType}" Width="100" />
                        <GridViewColumn Header="Действия" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Скачать" Click="DownloadActButton_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </ScrollViewer>
        <!-- Панель добавления акта -->
            <StackPanel x:Name="AddActPanel" Grid.Row="1" Margin="10" Visibility="Collapsed">
                <Label Content="Выбранный проект:" />
                <TextBlock x:Name="SelectedProjectTextBlock" Margin="0,0,0,10" />
                <Button Content="Сменить проект" Click="ChangeProjectButton_Click" Margin="0,0,0,10" />
                <Label Content="Выбранный файл:" />
                <TextBlock x:Name="SelectedFileTextBlock" Margin="0,0,0,10" />
                <Button Content="Выбрать файл" Click="SelectFileButton_Click" />
                <Button Content="Сохранить" Click="SaveActButton_Click" Margin="0,10,0,0" />
                <Button Content="Отмена" Click="CancelButton_Click" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
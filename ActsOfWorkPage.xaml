<Page x:Class="GeotekMetallCompleteDesktop.ActsOfWorkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700" 
      Title="Управление актами"
      Background="{StaticResource ActsOfWorkPage_BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Grid.Row="0" Margin="10,1,10,5" Style="{StaticResource FilterPanelStyle}">
            <Button Content="Добавить акт" 
                    x:Name="AddBtm" 
                    Click="AddActButton_Click" 
                    Margin="0,0,10,0"  
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Выбрать проект" 
                    x:Name="SelectBtm" 
                    Click="SelectProjectButton_Click" 
                    Margin="0,0,10,0" 
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="ResetProjectButton" 
                    Content="Сбросить проект" 
                    Click="ResetProjectButton_Click" 
                    Margin="0,0,10,0" 
                    Visibility="Collapsed"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView x:Name="ActsListView" Width="auto" Height="615">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ActID}" Width="50" />
                            <GridViewColumn Header="Дата загрузки" DisplayMemberBinding="{Binding ActDate, StringFormat=dd.MM.yyyy}" Width="120" />
                            <GridViewColumn Header="Тип файла" DisplayMemberBinding="{Binding FileType}" Width="100" />
                            <GridViewColumn Header="Действия" Width="auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource ActionsStackPanelStyle}">
                                            <Button Content="Скачать" Click="DownloadActButton_Click" Margin="2" Style="{StaticResource DownloadButtonStyle}" Width="auto"/>
                                            <Button Content="Посмотреть" Click="ViewActButton_Click" Margin="2" Style="{StaticResource SecondaryButtonStyle}" Width="auto"/>
                                            <Button Content="Редактировать" Click="EditActButton_Click" Margin="2" Style="{StaticResource EditButtonStyle}" Width="auto"/>
                                            <Button Content="Удалить" Click="DeleteActButton_Click" Margin="2" Style="{StaticResource DangerButtonStyle}" Width="auto"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>

            <Border x:Name="AddActPanel" 
                    CornerRadius="4" 
                    Padding="20" 
                    Margin="10" 
                    Visibility="Collapsed"
                    Effect="{StaticResource ShadowEffect}" 
                    Style="{StaticResource BorderStyle}">
                <StackPanel>
                    <TextBlock Text="Добавление акта" x:Name="HeaderTextBlock" 
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center"/>

                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Выбранный проект:" 
                                   Grid.Row="0" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                            <TextBlock x:Name="SelectedProjectTextBlock" 
                                       Style="{StaticResource ValueStyle}" 
                                       VerticalAlignment="Center" />
                            <Button Content="Выбрать проект" x:Name="ChangeProjectButton" 
                                    Click="ChangeProjectButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Width="150"/>
                        </StackPanel>

                        <TextBlock Text="Способ добавления:" 
                                   Grid.Row="1" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                            <Button Content="Выбрать файл" 
                                    Click="SelectFileButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="150"/>
                            <Button Content="Создать новый" 
                                    Click="CreateNewActButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="150"/>
                        </StackPanel>

                        <TextBlock Text="Файл:" 
                                   Grid.Row="2" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}" 
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SelectedFileTextBlock" 
                                   Grid.Row="2" Grid.Column="1" 
                                   Style="{StaticResource ValueStyle}"/>

                        <StackPanel Grid.Row="4" Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                            <Button Content="Сохранить" x:Name="SaveActButton"
                                    Click="SaveActButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Width="120"/>
                            <Button Content="Отмена" 
                                    Click="CancelButton_Click" 
                                    Style="{StaticResource CancelButtonStyle}" 
                                    Width="120"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
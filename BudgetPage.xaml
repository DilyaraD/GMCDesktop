<Page x:Class="GeotekMetallCompleteDesktop.BudgetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700"
      Title="Управление бюджетом">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel x:Name="FilterPanel" Margin="10,1,10,5" Orientation="Horizontal" Grid.Row="0" Style="{StaticResource FilterPanelStyle}">
            <Button Content="Добавить транзакцию" x:Name="AddBtm" Click="AddTransactionButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Выбрать проект" x:Name="SelectBtm" Click="SelectProjectButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="ResetProjectButton" Content="Сбросить проект" Click="ResetProjectButton_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView x:Name="TransactionsListView"  Height="615"
                          MouseDoubleClick="TransactionsListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding TransactionID}" Width="50" />
                            <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding TransactionDate, StringFormat=dd.MM.yyyy}" Width="100" />
                            <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Amount}" Width="100" />
                            <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="200" />
                            <GridViewColumn Header="Проект" DisplayMemberBinding="{Binding Projects.Requests.ObjectName}" Width="200" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>

            <Border x:Name="AddTransactionPanel" Style="{StaticResource BorderStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Добавление транзакции" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Выбранный проект:" Grid.Row="0" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="SelectedProjectTextBlock" Style="{StaticResource ValueStyle}"/>
                            <Button Content="Выбрать проект" Click="ChangeProjectButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Сумма:" Grid.Row="1" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <TextBox x:Name="AmountTextBox" Grid.Row="1" Grid.Column="1" 
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewTextInput="AmountTextBox_PreviewTextInput" 
                                 PreviewKeyDown="AmountTextBox_PreviewKeyDown"/>

                        <TextBlock Text="Тип транзакции:" Grid.Row="2" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <ComboBox x:Name="TransactionTypeComboBox" Grid.Row="2" Grid.Column="1"
                                   SelectionChanged="TransactionTypeComboBox_SelectionChanged" Margin="10,0,0,0">
                            <ComboBoxItem Content="Закупка материалов" />
                            <ComboBoxItem Content="Оплата труда" />
                            <ComboBoxItem Content="Аренда оборудования" />
                            <ComboBoxItem Content="Транспортные расходы" />
                            <ComboBoxItem Content="Другое" />
                        </ComboBox>

                        <StackPanel x:Name="CustomDescriptionPanel" Grid.Row="3" Grid.Column="1" 
                                    Visibility="Collapsed">
                            <TextBlock Text="Введите название транзакции:" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox x:Name="DescriptionTextBox" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel x:Name="AttachedFilesStackPanel" Grid.Row="4" Grid.Column="1">
                            <TextBlock Text="Прикрепленные документы:" Margin="10" Style="{StaticResource InputLabelStyle}"  />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Добавить файл" Click="AddFileButton_Click" 
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <Button Content="Удалить" Click="RemoveFileButton_Click" 
                                        Style="{StaticResource CancelButtonStyle}" 
                                        Visibility="Collapsed"/>
                            </StackPanel>
                            <ListBox x:Name="AttachedFilesListBox" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Сохранить" Click="SaveTransactionButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Отмена" Click="CancelButton_Click" 
                                    Style="{StaticResource CancelButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
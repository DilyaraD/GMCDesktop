<Page x:Class="GeotekMetallCompleteDesktop.MyDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d"       
      d:DesignHeight="500" d:DesignWidth="720"      
      Title="мои данные">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20,0,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

            <Border x:Name="InfoDataBorder" Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20"
                        Effect="{StaticResource ShadowEffect}">
                <StackPanel x:Name="InfoData">
                    <Grid Height="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Text="Логин:" Style="{StaticResource LabelStyle12}" />
                        <TextBlock Grid.Column="1"  x:Name="LoginDisplayTextBlock" Style="{StaticResource ValueStyle}" />

                        <TextBlock Grid.Column="0" Text="Имя:" Style="{StaticResource LabelStyle12}" Grid.Row="1" />
                        <TextBlock Grid.Column="1" x:Name="FirstNameDisplayTextBlock" Style="{StaticResource ValueStyle}" Grid.Row="1" />

                        <TextBlock Grid.Column="0" Text="Фамилия:" Style="{StaticResource LabelStyle12}" Grid.Row="2" />
                        <TextBlock Grid.Column="1" x:Name="LastNameDisplayTextBlock" Style="{StaticResource ValueStyle}" Grid.Row="2" />

                        <TextBlock Grid.Column="0" Text="Телефон:" Style="{StaticResource LabelStyle12}" Grid.Row="3" />
                        <TextBlock Grid.Column="1" x:Name="PhoneNumberDisplayTextBlock" Style="{StaticResource ValueStyle}" Grid.Row="3" />

                        <TextBlock Grid.Column="0" Text="Email:" Style="{StaticResource LabelStyle12}" Grid.Row="4" />
                        <TextBlock Grid.Column="1" x:Name="EmailDisplayTextBlock" Style="{StaticResource ValueStyle}" Grid.Row="4" />
                    </Grid>
                    <Button x:Name="EditButton" Grid.Row="1" Content="Редактировать профиль" Height="40" Padding="15,10" Click="EditButton_Click"
                    Style="{StaticResource ButtonStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" x:Name="EditUserBorder" Visibility="Collapsed" Background="White" CornerRadius="10"
                    Padding="15" Effect="{StaticResource ShadowEffect}">
                <StackPanel x:Name="EditUserStackPanel" Height="500">
                    <TextBlock x:Name="NameText" Text="Редактировать профиль" Style="{StaticResource TextBlockStyle}" Margin="0,10,0,5"/>

                    <TextBlock Text="Логин:" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="LoginTextBox" Text="Логин" Tag="Логин" Style="{StaticResource ModernTextBoxStyle}" MaxLength="50"/>
                    <TextBlock x:Name="LoginErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" />

                    <TextBlock Text="Пароль:" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="PasswordTextBox" Text="Пароль" Tag="Пароль" Style="{StaticResource ModernTextBoxStyle}" MaxLength="50"/>
                    <TextBlock x:Name="PasswordErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" />

                    <TextBlock Text="Имя:" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="FirstNameTextBox" Text="Имя" Tag="Имя" Style="{StaticResource ModernTextBoxStyle}" PreviewTextInput="NameTextBox_PreviewTextInput" MaxLength="50"/>
                    <TextBlock x:Name="FirstNameErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" />

                    <TextBlock Text="Фамилия:" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="LastNameTextBox" Text="Фамилия" Tag="Фамилия" Style="{StaticResource ModernTextBoxStyle}" PreviewTextInput="NameTextBox_PreviewTextInput" MaxLength="50"/>
                    <TextBlock x:Name="LastNameErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" />

                    <TextBlock Text="Телефон:" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="PhoneNumberTextBox" Text="Телефон" Tag="Телефон" Style="{StaticResource ModernTextBoxStyle}" PreviewTextInput="PhoneNumberTextBox_PreviewTextInput" MaxLength="11"/>
                    <TextBlock x:Name="PhoneNumberErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" />

                    <TextBlock Text="Email:" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="EmailTextBox" Text="Email" Tag="Email" Style="{StaticResource ModernTextBoxStyle}" MaxLength="50"/>
                    <TextBlock x:Name="EmailErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" />

                    <TextBlock Text="Должность:  " Style="{StaticResource InputLabelStyle}"><TextBlock x:Name="RoleComboBox" Style="{StaticResource InputLabelStyle}" /></TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Сохранить" Click="SaveButton_Click"  Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="Отменить" Click="CancelButton_Click" Style="{StaticResource CancleButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

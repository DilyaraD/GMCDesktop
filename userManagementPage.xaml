<Page x:Class="GeotekMetallCompleteDesktop.userManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="720"
      Title="управление пользователями">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10,10,10,5" Width="720">
            <Button Content="Добавить" Style="{StaticResource ButtonPageStyle}" Click="AddButton_Click" DockPanel.Dock="Left"  Width="100"/>
            <TextBox x:Name="searchTextBox" Visibility="Collapsed" Tag="Введите логин или имя" Text="Введите логин или имя" Margin="10,0,0,-10" 
                          Width="400"  TextChanged="SearchTextBox_TextChanged"/>
            <ToggleButton x:Name="searchButton" Content="Поиск" Style="{StaticResource ToggleButtonPageStyle}"  Width="100"
                          Checked="SearchButton_Checked" Unchecked="SearchButton_Unchecked"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="UserListStackPanel">
                <ListView x:Name="userList" MouseDoubleClick="UserList_MouseDoubleClick" Width="700">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Логин" Width="100" DisplayMemberBinding="{Binding Login}" />
                            <GridViewColumn Header="Должность" Width="100" DisplayMemberBinding="{Binding Role}" />
                            <GridViewColumn Header="Имя" Width="110" DisplayMemberBinding="{Binding FirstName}" />
                            <GridViewColumn Header="Фамилия" Width="110" DisplayMemberBinding="{Binding LastName}" />
                            <GridViewColumn Header="Email" Width="150" DisplayMemberBinding="{Binding Email}" />
                            <GridViewColumn Header="Телефон" Width="120" DisplayMemberBinding="{Binding PhoneNumber}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

            <Border  x:Name="AddUserStackPanel1" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="10" Effect="{StaticResource ShadowEffect}" Margin="30">
                <StackPanel x:Name="AddUserStackPanel"  Visibility="Collapsed" Width="600" Height="400">
                    <TextBlock x:Name="NameText" Text="Добавить пользователя" Style="{StaticResource TextBlockStyle}" Margin="0,10,0,5"/>
                    <TextBox x:Name="LoginTextBox" Text="Логин" Tag="Логин" MaxLength="50" Margin="0,5,0,0" />
                    <TextBlock x:Name="LoginExistsTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}"/>
                    <TextBox x:Name="PasswordTextBox" Text="Пароль" Tag="Пароль" MaxLength="50" Margin="0,5,0,0"/>
                    <TextBlock x:Name="PasswordErrorTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}"  />
                    <TextBox x:Name="FirstNameTextBox" Text="Имя" Tag="Имя" MaxLength="50" Margin="0,5,0,0"  PreviewTextInput="NameTextBox_PreviewTextInput"/>
                    <TextBlock x:Name="FirstNameErrorTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}"  />
                    <TextBox x:Name="LastNameTextBox" Text="Фамилия" Tag="Фамилия" MaxLength="50" Margin="0,5,0,0"  PreviewTextInput="NameTextBox_PreviewTextInput"/>
                    <TextBlock x:Name="LastNameErrorTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}"  />
                    <TextBox x:Name="PhoneNumberTextBox" Text="Телефон" Tag="Телефон" MaxLength="11"
                             PreviewTextInput="PhoneNumberTextBox_PreviewTextInput" Margin="0,5,0,0" />
                    <TextBlock x:Name="PhoneNumberErrorTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}" />
                    <TextBox x:Name="EmailTextBox" Text="Электронная почта" Tag="Электронная почта" MaxLength="50" Margin="0,5,0,0" />
                    <TextBlock x:Name="EmailErrorTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}"  />
                    <StackPanel>
                        <TextBlock Text="Должность:" FontSize="14" FontFamily="Leelawadee" Margin="0,5,0,0" />
                        <ComboBox x:Name="RoleComboBox" />
                            <TextBlock x:Name="RoleErrorTextBlock" Visibility="Collapsed" Style="{StaticResource TextBoxStyle}"  />
                        </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="cохранить" Click="SaveButton_Click" Style="{StaticResource ButtonPageStyle}" Width="100"/>
                        <Button Content="удалить" x:Name="DeleteButton" Click="DeleteButton_Click"  Visibility="Collapsed" Style="{StaticResource ButtonPageStyle}" Width="100"/>
                        <Button Content="oтмена" Click="CancelButton_Click" Style="{StaticResource ButtonPageStyle}" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
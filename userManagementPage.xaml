<Page x:Class="GeotekMetallCompleteDesktop.userManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700"
      Title="Управление пользователями">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Style="{StaticResource FilterPanelStyle}" Height="60">
            <Button Content="Добавить" Style="{StaticResource PrimaryButtonStyle}"  Height="auto" Margin="0, 10, 10, 10"
                    Click="AddButton_Click"/>
            <TextBox x:Name="searchTextBox" Tag="Введите логин или имя" 
                     Style="{StaticResource TextBoxStyle}" 
                     Visibility="Collapsed" Width="300" Margin="0, 10, 0, 10"
                     TextChanged="SearchTextBox_TextChanged"/>
            <ToggleButton x:Name="searchButton" Content="Поиск" 
                          Style="{StaticResource ToggleButtonStyle}" Height="auto" Margin=" 10, 10, 0, 10"
                          Checked="SearchButton_Checked" Unchecked="SearchButton_Unchecked"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600" x:Name="UserListStackPanel">
                <ListView x:Name="userList" MouseDoubleClick="UserList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="100"/>
                            <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding Role}" Width="100"/>
                            <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding FirstName}" Width="100"/>
                            <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding LastName}" Width="100"/>
                            <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="150"/>
                            <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding PhoneNumber}" Width="100"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>

            <Border x:Name="AddUserStackPanel1" Style="{StaticResource BorderStyle}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Height="auto" MaxHeight="550" x:Name="AddUserStackPanel">
                    <StackPanel>
                    <TextBlock x:Name="NameText" Text="Добавить пользователя" 
                               Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock x:Name="LogText" Text="Логин:" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox x:Name="LoginTextBox" Tag="Логин" Style="{StaticResource TextBoxStyle}" MaxLength="20" PreviewTextInput="LoginTextBox_PreviewTextInput"/>
                    <TextBlock x:Name="LoginExistsTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <TextBlock Text="Пароль:" Style="{StaticResource InputLabelStyle}"/>
                    <TextBox x:Name="PasswordTextBox" Tag="Пароль" Style="{StaticResource TextBoxStyle}" MaxLength="20"/>
                    <TextBlock x:Name="PasswordErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <TextBlock Text="Имя:" Style="{StaticResource InputLabelStyle}"/>
                    <TextBox x:Name="FirstNameTextBox" Tag="Имя" Style="{StaticResource TextBoxStyle}" 
                             MaxLength="20" PreviewTextInput="NameTextBox_PreviewTextInput"/>
                    <TextBlock x:Name="FirstNameErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <TextBlock Text="Фамилия:" Style="{StaticResource InputLabelStyle}"/>
                    <TextBox x:Name="LastNameTextBox" Tag="Фамилия" Style="{StaticResource TextBoxStyle}" 
                             MaxLength="20" PreviewTextInput="NameTextBox_PreviewTextInput"/>
                    <TextBlock x:Name="LastNameErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <TextBlock Text="Телефон:" Style="{StaticResource InputLabelStyle}"/>
                    <TextBox x:Name="PhoneNumberTextBox" Tag="Телефон" Style="{StaticResource TextBoxStyle}" 
                             MaxLength="11" PreviewTextInput="PhoneNumberTextBox_PreviewTextInput"/>
                    <TextBlock x:Name="PhoneNumberErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <TextBlock Text="Электронная почта:" Style="{StaticResource InputLabelStyle}"/>
                    <TextBox x:Name="EmailTextBox" Tag="Электронная почта" Style="{StaticResource TextBoxStyle}" 
                             MaxLength="100" PreviewTextInput="EmailTextBox_PreviewTextInput" LostFocus="EmailTextBox_LostFocus"/>
                    <TextBlock x:Name="EmailErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <TextBlock Text="Должность:" Style="{StaticResource InputLabelStyle}"/>
                    <ComboBox x:Name="RoleComboBox"  Margin="10, 0, 0, 0"/>
                    <TextBlock x:Name="RoleErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Сохранить" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Удалить" x:Name="DeleteButton" Click="DeleteButton_Click" 
                                Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed"/>
                        <Button Content="Отмена" Click="CancelButton_Click" Style="{StaticResource CancelButtonStyle}" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
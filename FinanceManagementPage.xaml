<Page x:Class="GeotekMetallCompleteDesktop.FinanceManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="700" 
      Title="управление финансовой отчетностью">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Кнопка добавления отчета -->
        <Button x:Name="AddReportButton" Content="Добавить отчет" Click="AddReportButton_Click" Margin="10" HorizontalAlignment="Left" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <ListView x:Name="FinancialReportsListView" Margin="10"
                      Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource SizeConverter}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ReportID}" Width="50" />
                        <GridViewColumn Header="Название отчета" DisplayMemberBinding="{Binding ReportType}" Width="150" />
                        <GridViewColumn Header="Дата отчета" DisplayMemberBinding="{Binding ReportDate, StringFormat=dd.MM.yyyy}" Width="100" />
                        <GridViewColumn Header="Проект" DisplayMemberBinding="{Binding Projects.Requests.ObjectName}" Width="200" />
                        <GridViewColumn Header="Действия" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Скачать" Click="DownloadReportButton_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>

        <StackPanel x:Name="AddReportStackPanel" Grid.Row="1" Margin="10" Visibility="Collapsed">
            <TextBlock Text="Добавление финансового отчета" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Название отчета:" />
            <TextBox x:Name="ReportTypeTextBox" Margin="0,5,0,4" />

            <TextBlock Text="Файл отчета:" />
            <Button x:Name="SelectFileButton" Content="Выбрать файл" Click="SelectFileButton_Click" Margin="0,5,0,5" />
            <TextBlock x:Name="SelectedFilePathTextBlock" Margin="0,5,0,5" />

            <Button x:Name="SaveReportButton" Content="Сохранить" Click="SaveReportButton_Click" Margin="0,5,0,0" />
            <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</Page>
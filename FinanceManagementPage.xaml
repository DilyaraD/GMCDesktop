<Page x:Class="GeotekMetallCompleteDesktop.FinanceManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700" 
      Title="Управление финансовой отчетностью">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" x:Name="Filter" Margin="10,1,10,5" Style="{StaticResource FilterPanelStyle}">
            <Button Click="SelectProjectButton_Click" Content="Выбрать проект" x:Name="SelectBtm" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Click="ResetProjectButton_Click" x:Name="ResetProjectButton" Content="Сбросить проект" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView x:Name="FinancialReportsListView" Height="615">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ReportID}" Width="50" />
                            <GridViewColumn Header="Название отчета" DisplayMemberBinding="{Binding ReportType}" Width="200" />
                            <GridViewColumn Header="Дата отчета" DisplayMemberBinding="{Binding ReportDate, StringFormat=dd.MM.yyyy}" Width="80" />
                            <GridViewColumn Header="Проект" DisplayMemberBinding="{Binding Projects.Requests.ObjectName}" Width="190" />
                            <GridViewColumn Header="Действия" Width="auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Style="{StaticResource ActionsStackPanelStyle}">
                                            <Button Content="Скачать" Click="DownloadReportButton_Click" Tag="{Binding}" Style="{StaticResource DownloadButtonStyle}" />
                                            <Button Content="Посмотреть" Click="ViewReportButton_Click" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
<Window x:Class="GeotekMetallCompleteDesktop.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
        mc:Ignorable="d"
        Title="Авторизация" Height="700" Width="1000"  MaxHeight="800" MaxWidth="1200" 
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="800">
    <Grid Background="#161F46">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="250">
            <Image Source="img/llogo.png"/>
            <TextBox x:Name="login" Margin="0,35,0,0" Tag="Логин" Text="Логин"/>
            <TextBox x:Name="password" Margin="0,15,0,0" Tag="Пароль" Text="Пароль" />

            <Button Click="Login_Click">войти</Button>
        </StackPanel>
    </Grid>
</Window>

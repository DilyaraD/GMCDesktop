<Page x:Class="GeotekMetallCompleteDesktop.requestManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700" 
      Title="Управление заявками">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="FilterStackPanel" Orientation="Horizontal" Style="{StaticResource FilterPanelStyle}" Margin="10,0,10,10">
            <ComboBox x:Name="FilterByStatusComboBox" Margin="0,0,10,0" SelectionChanged="FilterByStatusComboBox_SelectionChanged">
                <ComboBoxItem Content="Все заявки"/>
                <ComboBoxItem Content="Новые"/>
                <ComboBoxItem Content="Принятые"/>
                <ComboBoxItem Content="Отклоненные"/>
            </ComboBox>
            <ComboBox x:Name="SortByDeadlineComboBox"  Margin="0,0,10,0" SelectionChanged="SortByDeadlineComboBox_SelectionChanged">
                <ComboBoxItem Content="Сортировка по дедлайну" IsEnabled="False"/>
                <ComboBoxItem Content="Ближайшие"/>
                <ComboBoxItem Content="Убывание"/>
            </ComboBox>
            <ComboBox x:Name="FilterByWorkTypeComboBox"  Margin="0,0,10,0" SelectionChanged="FilterByWorkTypeComboBox_SelectionChanged">
                <ComboBoxItem Content="Все типы работ"/>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="RequestListStackPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListView x:Name="RequestList"  MouseDoubleClick="RequestList_MouseDoubleClick" Height="630">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Название объекта" 
                                                DisplayMemberBinding="{Binding ObjectName}" 
                                                Width="auto"/>
                                <GridViewColumn Header="Адрес" 
                                                DisplayMemberBinding="{Binding Address}" 
                                                Width="200"/>
                                <GridViewColumn Header="Цель" 
                                                DisplayMemberBinding="{Binding WorkTypeName}" 
                                                Width="auto"/>
                                <GridViewColumn Header="Дедлайн" 
                                                DisplayMemberBinding="{Binding Deadline, StringFormat=dd.MM.yyyy}" 
                                                Width="auto"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="RequestDetailsStackPanel" 
                        Visibility="Collapsed" 
                        Margin="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="630">
                    <StackPanel>
                        <Button x:Name="BackToUserButton" 
                                Content="Назад к пользователю" 
                                Click="BackToUserButton_Click" 
                                Margin="0,10,0,5" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Text="Детали заявки" 
                                   Style="{StaticResource SectionHeaderStyle}" 
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="RequestDetailsItemsControl" 
                                      Style="{StaticResource ItemsControlStyle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" 
                                                   Style="{StaticResource InputLabelStyle}" 
                                                   Grid.Column="0"/>
                                        <TextBlock Text="{Binding Value}" 
                                                   Style="{StaticResource ValueStyle}" 
                                                   Grid.Column="1"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="BackButton" 
                                Content="Назад" 
                                Click="BackButton_Click" 
                                Margin="0,10,0,5" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="ApproveButton" 
                                Content="Принять заявку" 
                                Click="ApproveButton_Click" 
                                Margin="0,5,0,5" 
                                Visibility="Collapsed" 
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="RejectButton" 
                                Content="Отклонить заявку" 
                                Click="RejectButton_Click" 
                                Margin="0,5,0,10" 
                                Visibility="Collapsed" 
                                Style="{StaticResource DangerButtonStyleForRequest}"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="ReasonInputStackPanel" 
                        Visibility="Collapsed" 
                        Margin="10">
                <TextBlock Text="Введите причину:" 
                           Style="{StaticResource InputLabelStyle}"/>
                <TextBox x:Name="ReasonTextBox" 
                         Style="{StaticResource TextBoxStyle}" 
                         Height="150" Width="700" VerticalContentAlignment="Top"
                         AcceptsReturn="True" MaxLength="750"
                         TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="ConfirmReasonButton" 
                            Content="Подтвердить" 
                            Click="ConfirmReasonButton_Click" 
                            Margin="0,10,10,0" 
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button x:Name="CancelReasonButton" 
                            Content="Отмена" 
                            Click="CancelReasonButton_Click" 
                            Margin="0,10,0,0" 
                            Style="{StaticResource CancelButtonStyle}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="CreateProjectStackPanel" 
                        Visibility="Collapsed" 
                        Margin="10">
                <TextBlock Text="Создание проекта" 
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Дата начала проекта:" 
                               Style="{StaticResource InputLabelStyle}" 
                               Grid.Row="0" Grid.Column="0" 
                               VerticalAlignment="Center"/>
                    <DatePicker x:Name="ProjectStartDatePicker" 
                                Style="{StaticResource DatePickerStyle}" 
                                Grid.Row="0" Grid.Column="1" 
                                Margin="10,0,0,10"/>
                    <TextBlock Text="Дата окончания проекта:" 
                               Style="{StaticResource InputLabelStyle}" 
                               Grid.Row="1" Grid.Column="0" 
                               VerticalAlignment="Center"/>
                    <DatePicker x:Name="ProjectEndDatePicker" 
                                Style="{StaticResource DatePickerStyle}" 
                                Grid.Row="1" Grid.Column="1" 
                                Margin="10,0,0,10"/>
                    <TextBlock Text="Ответственный за проект:" 
                               Style="{StaticResource InputLabelStyle}" 
                               Grid.Row="2" Grid.Column="0" 
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="ProjectManagerComboBox" 
                              DisplayMemberPath="FullName" 
                              Grid.Row="2" Grid.Column="1" 
                              Margin="10,0,0,10"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Grid.Row="3" Grid.Column="1">
                        <Button x:Name="CreateProjectButton" 
                                Content="Создать проект" 
                                Click="CreateProjectButton_Click" 
                                Margin="0,0,10,0" 
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="CancelProjectButton" 
                                Content="Отмена" 
                                Click="CancelProjectButton_Click" 
                                Margin="0" 
                                Style="{StaticResource CancelButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
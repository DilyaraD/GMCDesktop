<Window x:Class="GeotekMetallCompleteDesktop.SelectProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор проекта" MinHeight="350" MinWidth="500"
        MaxHeight="350" MaxWidth="500" WindowStartupLocation="CenterScreen">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListView x:Name="ProjectsListView" Margin="10,10,10,50">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ProjectID}" Width="20" />
                        <GridViewColumn Header="Название проекта" DisplayMemberBinding="{Binding Requests.ObjectName}" Width="200" />
                        <GridViewColumn Header="Адрес" DisplayMemberBinding="{Binding Requests.Address}" Width="250" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>
        <Button Content="Выбрать" Click="SelectButton_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />
    </Grid>
</Window>
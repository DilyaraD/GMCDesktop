<Window x:Class="GeotekMetallCompleteDesktop.SelectProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор проекта" MinHeight="350" MinWidth="550"
        MaxHeight="400" MaxWidth="500" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтрации -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">           
            <ComboBox x:Name="StatusFilterComboBox" Width="150" 
                      SelectionChanged="StatusFilterComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- Список проектов -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <ListView x:Name="ProjectsListView" Margin="10,0,10,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ProjectID}" Width="auto" />
                        <GridViewColumn Header="Название проекта" DisplayMemberBinding="{Binding Requests.ObjectName}" Width="auto" />
                        <GridViewColumn Header="Адрес" DisplayMemberBinding="{Binding Requests.Address}" Width="250" />
                        <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="auto" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>

        <!-- Кнопка выбора -->
        <Button Content="Выбрать" Click="SelectButton_Click" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="10" Grid.Row="2"/>
    </Grid>
</Window>
<Page x:Class="GeotekMetallCompleteDesktop.ContractsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeotekMetallCompleteDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="700" 
      Title="Управление договорами">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Margin="10,1,10,5" Grid.Row="0" Style="{StaticResource FilterPanelStyle}">
            <Button Content="Добавить договор" 
                    x:Name="AddButton" 
                    Click="AddContractButton_Click" 
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Выбрать проект" 
                    x:Name="SelectButton" 
                    Click="SelectProjectButton_Click" 
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="ResetProjectButton" 
                    Content="Сбросить проект" 
                    Click="ResetProjectButton_Click" 
                    Visibility="Collapsed"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListView x:Name="ContractsListView" Height="615">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ContractID}" Width="50" />
                            <GridViewColumn Header="Дата загрузки" DisplayMemberBinding="{Binding ContractDate, StringFormat=dd.MM.yyyy}" Width="120" />
                            <GridViewColumn Header="Тип файла" DisplayMemberBinding="{Binding FileType}" Width="100" />
                            <GridViewColumn Header="Действия" Width="auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource ActionsStackPanelStyle}">
                                            <Button Content="Скачать" 
                                                    Click="DownloadContractButton_Click" 
                                                    Style="{StaticResource DownloadButtonStyle}"/>
                                            <Button Content="Посмотреть" 
                                                    Click="ViewContractButton_Click" 
                                                    Style="{StaticResource SecondaryButtonStyle}"/>
                                            <Button Content="Редактировать" 
                                                    Click="EditContractButton_Click" 
                                                    Style="{StaticResource EditButtonStyle}"/>
                                            <Button Content="Удалить" 
                                                    Click="DeleteContractButton_Click" 
                                                    Style="{StaticResource DangerButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>

            <Border x:Name="AddContractPanel" 
                    Style="{StaticResource BorderStyle}" 
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Добавление договора" x:Name="HeaderTextBlock" 
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Выбранный проект:" 
                                   Grid.Row="0" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="SelectedProjectTextBlock" 
                                       Style="{StaticResource ValueStyle}"/>
                            <Button Content="Выбрать проект" x:Name="ChangeProjectButton" 
                                    Click="ChangeProjectButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Способ добавления:" 
                                   Grid.Row="1" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Выбрать файл" 
                                    Click="SelectFileButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Создать новый" 
                                    Click="CreateNewContractButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Файл:" 
                                   Grid.Row="2" Grid.Column="0" 
                                   Style="{StaticResource InputLabelStyle}"/>
                        <TextBlock x:Name="SelectedFileTextBlock" 
                                   Grid.Row="2" Grid.Column="1" 
                                   Style="{StaticResource ValueStyle}"/>

                        <StackPanel Grid.Row="4" Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                            <Button Content="Сохранить" x:Name="SaveContractButton"
                                    Click="SaveContractButton_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Отмена" 
                                    Click="CancelButton_Click" 
                                    Style="{StaticResource CancelButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>